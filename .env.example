# Copy this file to `.env` (or `.env.local`) and fill in real values.
# DO NOT commit your real `.env` — keep secrets out of source control.

# Clerk (authentication)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_JWKS_URL=https://your-clerk-domain/.well-known/jwks.json

# AWS / Deployment
DEFAULT_AWS_REGION=eu-north-1
AWS_ACCOUNT_ID=123456789012

# LLM providers
OPENROUTER_API_KEY=sk-or-REPLACE_ME
OPENROUTER_BASE_URL=https://api.openrouter.ai/v1
OPENAI_API_KEY=sk-REPLACE_ME
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=sk-anthropic-REPLACE_ME

# Email (app password for SMTP)
EMAIL_SMTP_SERVER=smtp.example.com
EMAIL_APP_PASSWORD="YOUR_SMTP_APP_PASSWORD"
EMAIL_ADDRESS=you@example.com

# Frontend backend base URL used by client code
# Example: http://localhost:8000 for local Docker or dev
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
